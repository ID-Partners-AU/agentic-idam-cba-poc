# The one place the PingFederate version is written down. Everything that names a PingFederate reads
# this file or is checked against it by tools/pf-version-check.py: the four workflows and the composite
# action (the image, pulled by digest), the rig's author.sh (the authoring image), apply.sh and
# provider.tf (the Terraform product version), the BOM (the SDK version the provided jars are
# installed under) and build/pingfederate/Dockerfile (whose FROM stays a literal so Dependabot can
# bump it; tools/pf-version-sync.py rewrites this file from it afterwards).
#
# KEY=VALUE only, no quoting, no expansion: it is sourced by bash, appended to $GITHUB_ENV and parsed
# by the Python tools, and each of those reads it differently.
PF_VERSION=13.1.3
PF_SDK_MAVEN_VERSION=13.1.3.0
PF_IMAGE=pingidentity/pingfederate:13.1.3-alpine_3.24.1-al21-latest
# The index (manifest list) digest, from `docker buildx imagetools inspect $PF_IMAGE` on 2026-09-26; the
# same digest the local image reports under RepoDigests.
PF_IMAGE_DIGEST=sha256:0d559261d658222179b07de8b2c84a8aea3cb30c7be107970686f58ea9dd3a4a
# What the Terraform provider is told (major.minor): it decides which fields the provider may send.
PF_TERRAFORM_PRODUCT_VERSION=13.1
