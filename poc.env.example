# The PoC's settings: copy to poc.env (git-ignored) and fill in. ./rig.sh reads it and exports everything here to
# up.sh, docker compose and the harness.
#
# This branch runs on the self-hosted Trust Controller (demo/federation, go-openid-federation) instead of Raidiam
# Connect: everything is on this machine - no tunnel, no Raidiam account, no directory client. The anchor's keys are
# made on its first start and pinned by ./rig.sh federation (a step of ./rig.sh up) into .federation.env.

# ── Names and ports ─────────────────────────────────────────────────────────────────────────────────────────────
# Prefix for every container, image, network and volume, so the PoC never collides with anything else on the host.
POC_NAME=agentic-oidf
# PingFederate's host ports (runtime TLS, plain HTTP, admin console).
PF_PORT_HTTPS=9031
PF_PORT_HTTP=9080
PF_PORT_ADMIN=9999
MARKETPLACE_PORT=3000

# ── Ping licences ───────────────────────────────────────────────────────────────────────────────────────────────
# A KEY=VALUE file with PING_IDENTITY_DEVOPS_USER and PING_IDENTITY_DEVOPS_KEY: PingFederate and PingAuthorize fetch
# evaluation licences with them at start-up.
PING_DEVOPS_CONFIG=${HOME}/.pingidentity/config
# Optional. A PingFederate licence file to use instead of an evaluation licence. Where a TLS-inspecting proxy or
# antivirus breaks the licence fetch, put licence files in demo/licences/ (git-ignored): this for PingFederate, and
# demo/licences/PingAuthorize.lic, which ./rig.sh services mounts into PingAuthorize and its PAP.
PF_LICENSE_FILE=

# ── PingFederate's issuer ───────────────────────────────────────────────────────────────────────────────────────
# host.docker.internal resolves on the host and in every container (Docker Desktop); nothing outside needs to reach it.
PF_BASE_URL=https://host.docker.internal:9031

# ── The federation: the self-hosted Trust Controller (demo/federation) ─────────────────────────────────────────
FED_BASE_URL=https://host.docker.internal:9443
AUTHORITY_HINT=https://host.docker.internal:9443/authority
TRUST_ANCHOR=https://host.docker.internal:9443/anchor
DIRECTORY_URL=https://host.docker.internal:9443/directory
RAIDIAM_BASE_URL=https://host.docker.internal:9443/api
RAIDIAM_ISSUER=https://host.docker.internal:9443
RAIDIAM_MANAGED_ENTITY_BASE=https://host.docker.internal:9443/openid_relying_party
# The organisation the PoC's software statements are created under.
RAIDIAM_ORGANISATION_ID=CBA-123
# PingFederate's authorisation server record in the directory: the Trust Controller creates it with this id.
AUTHORISATION_SERVER_ID=7d2f5b8e-4c1a-4f6e-9b3d-2a8c6e1f0d47
# The marketplace drives the Trust Controller's API with no sign-in; not mock mode.
RAIDIAM_GRANT=none
RAIDIAM_MOCK=false
RAIDIAM_DIRECTORY_CLIENT_ID=self-hosted
RAIDIAM_DIRECTORY_SIGNING_KID=none

# ── The PoC's entities ──────────────────────────────────────────────────────────────────────────────────────────
# The origin the sub-agents serve their own Entity Configurations at: <it>/agent/<name>. Principal versions are hosted
# by the Trust Controller (federation-managed statements the marketplace creates).
RAIDIAM_PROVIDER_ID=https://host.docker.internal:8443
RAIDIAM_RESOURCE_ID=https://host.docker.internal:8446
RAIDIAM_PAYMENTS_RESOURCE_ID=https://host.docker.internal:8447
RAIDIAM_HOSTED_AGENTS="accounts-agent payments-agent"

# ── Bridge keys ─────────────────────────────────────────────────────────────────────────────────────────────────
# vault: OpenBao's transit engine, never exported (Principal versions need it). Needs python3 with cryptography and
# PyJWT on the host (demo/openbao/setup.py, demo/federation/seed.py).
RAIDIAM_BRIDGE_BACKING=vault

# ── Workload identity ───────────────────────────────────────────────────────────────────────────────────────────
TRUST_DOMAIN=example.org
