# The PoC's settings: copy to poc.env (git-ignored) and fill in. ./rig.sh reads it and exports everything here to
# up.sh, docker compose and the harness. Values marked REQUIRED have no default; the rest are the usual ones.

# ── Names and ports ─────────────────────────────────────────────────────────────────────────────────────────────
# Prefix for every container, image, network and volume, so the PoC never collides with anything else on the host.
POC_NAME=agentic-poc
# PingFederate's host ports (runtime TLS, plain HTTP, admin console).
PF_PORT_HTTPS=9031
PF_PORT_HTTP=9080
PF_PORT_ADMIN=9999
MARKETPLACE_PORT=3000

# ── Ping licences ───────────────────────────────────────────────────────────────────────────────────────────────
# A KEY=VALUE file with PING_IDENTITY_DEVOPS_USER and PING_IDENTITY_DEVOPS_KEY: PingFederate and PingAuthorize fetch
# evaluation licences with them at start-up.
PING_DEVOPS_CONFIG=${HOME}/.pingidentity/config
# Optional. A PingFederate licence file (pingfederate.lic, covering PingFederate 13.1) to use instead of an evaluation
# licence: PingFederate then fetches nothing at start-up. PingAuthorize still uses PING_DEVOPS_CONFIG. Keep the file
# outside this directory, or anywhere git ignores it (*.lic is ignored under demo/).
PF_LICENSE_FILE=

# ── PingFederate's issuer ───────────────────────────────────────────────────────────────────────────────────────
# REQUIRED. The public origin PingFederate advertises as its issuer. Raidiam fetches its discovery document and its
# Entity Configuration from it, so it must be reachable from the internet (an ngrok tunnel to PF_PORT_HTTPS, say).
PF_BASE_URL=

# ── The federation (Raidiam) ────────────────────────────────────────────────────────────────────────────────────
# The CBA federation's authority (PingFederate's superior, and every PoC entity's authority_hints) and its trust anchor.
AUTHORITY_HINT=https://authority.directory.cba.raidiam.io/authority/5a27c88b-97ed-4d37-a3c8-59c66b19aa25
TRUST_ANCHOR=https://federation.directory.cba.raidiam.io/federation_entity/ff726945-ebd7-45e2-9869-c11227669433
# REQUIRED. The anchor's public key set, pinned: copy the jwks from <TRUST_ANCHOR>/.well-known/openid-federation and
# check it out of band. A chain is trusted because it ends at this key, not at whatever the URL serves.
TRUST_ANCHOR_JWKS=
# Raidiam's public directory export, its admin API and its authorisation server.
DIRECTORY_URL=https://data.directory.cba.raidiam.io
RAIDIAM_BASE_URL=https://matls-api.directory.cba.raidiam.io
RAIDIAM_ISSUER=https://auth.directory.cba.raidiam.io
# The organisation the PoC's software statements are created under.
RAIDIAM_ORGANISATION_ID=CBA-123
# REQUIRED. The id of PingFederate's authorisation server record in Raidiam (its Issuer must be PF_BASE_URL).
AUTHORISATION_SERVER_ID=

# ── The PoC's entities, as registered in Raidiam (each ClientId exactly as written here) ───────────────────────
# The origin the sub-agents serve their own Entity Configurations at: <it>/agent/<name>. There is no agent provider:
# Principal versions are hosted by Raidiam (federation-managed statements the marketplace creates).
RAIDIAM_PROVIDER_ID=https://host.docker.internal:8443
RAIDIAM_RESOURCE_ID=https://host.docker.internal:8446
RAIDIAM_PAYMENTS_RESOURCE_ID=https://host.docker.internal:8447
RAIDIAM_HOSTED_AGENTS="accounts-agent payments-agent"

# ── The marketplace's Raidiam directory client (an operator signs in with it) ───────────────────────────────────
# REQUIRED. Its Raidiam openid_relying_party URL, e.g. https://rp.directory.cba.raidiam.io/openid_relying_party/<id>.
# Its redirect URI must be https://localhost:8443/cb. Its keys go in demo/keys/raidiam/directory-client/:
# signing.key (rtssigning, PEM), transport.crt + transport.key (rtstransport, for mutual TLS), ca.pem (the directory's
# TLS chain).
RAIDIAM_DIRECTORY_CLIENT_ID=
# REQUIRED. The kid Raidiam publishes for signing.key (see the client's keystore JWKS - not the RFC 7638 thumbprint).
RAIDIAM_DIRECTORY_SIGNING_KID=

# ── Bridge keys ─────────────────────────────────────────────────────────────────────────────────────────────────
# Where PingFederate's per-agent bridge keys live (attest_jwt_client_auth's handshake with PingFederate):
#   vault   OpenBao's transit engine, never exported: the marketplace creates each Principal version's key there when
#           it deploys it, and PingFederate signs with it - no restart. Needs python3 with cryptography and PyJWT on the
#           host (demo/openbao/setup.py). Principal versions need it.
#   config  a file read at start-up: the sub-agents only, no Principal versions.
RAIDIAM_BRIDGE_BACKING=vault

# ── Workload identity ───────────────────────────────────────────────────────────────────────────────────────────
TRUST_DOMAIN=example.org
